# Same whitespace/encoding rules in every editor and every ComplianceOps repo.
# VS Code needs the "EditorConfig for VS Code" extension to apply it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.go]
indent_style = tab

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.md]
# trailing double-space is a markdown line break
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
